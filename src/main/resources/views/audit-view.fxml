<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="controller.AuditLogController"
      spacing="10" prefWidth="760" prefHeight="560">

    <padding>
        <Insets top="15" right="15" bottom="15" left="15"/>
    </padding>

    <Label text="CineTrack — Historique des modifications" styleClass="titre"/>

    <HBox spacing="10">
        <Button text="Actualiser" onAction="#onActualiser"/>
    </HBox>

    <TableView fx:id="tableLogs" prefHeight="300" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="colDate" text="Date" prefWidth="170"/>
            <TableColumn fx:id="colUtilisateur" text="Utilisateur" prefWidth="150"/>
            <TableColumn fx:id="colTable" text="Table" prefWidth="130"/>
            <TableColumn fx:id="colAction" text="Action" prefWidth="100"/>
            <TableColumn fx:id="colRecord" text="ID enreg." prefWidth="90"/>
        </columns>
    </TableView>

    <Label text="Détail de la ligne sélectionnée"/>
    <TextArea fx:id="txtDetail" editable="false" wrapText="true" prefRowCount="7"/>

    <Label fx:id="lblMessage"/>
</VBox>