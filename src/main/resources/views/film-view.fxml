<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="controller.FilmController"
      spacing="10" prefWidth="760" prefHeight="520">

    <padding>
        <Insets top="15" right="15" bottom="15" left="15"/>
    </padding>

    <Label text="CineTrack — Gestion des films" styleClass="titre"/>

    <GridPane hgap="10" vgap="10">
        <Label text="Titre" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
        <TextField fx:id="txtTitre" GridPane.columnIndex="1" GridPane.rowIndex="0"/>
        <Label text="Genre" GridPane.columnIndex="2" GridPane.rowIndex="0"/>
        <ComboBox fx:id="comboGenre" prefWidth="200" GridPane.columnIndex="3" GridPane.rowIndex="0"/>

        <Label text="Durée (min)" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
        <TextField fx:id="txtDuree" GridPane.columnIndex="1" GridPane.rowIndex="1"/>
        <Label text="Note (0 à 10)" GridPane.columnIndex="2" GridPane.rowIndex="1"/>
        <TextField fx:id="txtNote" GridPane.columnIndex="3" GridPane.rowIndex="1"/>

        <Label text="Synopsis" GridPane.columnIndex="0" GridPane.rowIndex="2"/>
        <TextField fx:id="txtSynopsis" GridPane.columnIndex="1" GridPane.rowIndex="2"
                   GridPane.columnSpan="3"/>
    </GridPane>

    <HBox spacing="10">
        <Button text="Ajouter" onAction="#onAjouter"/>
        <Button text="Modifier" onAction="#onModifier"/>
        <Button text="Supprimer" onAction="#onSupprimer" styleClass="btn-supprimer"/>
        <Button text="Actualiser" onAction="#onActualiser"/>
    </HBox>

    <TableView fx:id="tableFilms" prefHeight="300" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="colId" text="ID" prefWidth="50"/>
            <TableColumn fx:id="colTitre" text="Titre" prefWidth="260"/>
            <TableColumn fx:id="colGenre" text="Genre" prefWidth="150"/>
            <TableColumn fx:id="colDuree" text="Durée" prefWidth="90"/>
            <TableColumn fx:id="colNote" text="Note" prefWidth="80"/>
        </columns>
    </TableView>

    <Label fx:id="lblMessage"/>
</VBox>