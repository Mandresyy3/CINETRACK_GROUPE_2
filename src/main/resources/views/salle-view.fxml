<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="controller.SalleController"
      spacing="10" prefWidth="760" prefHeight="520">

    <padding>
        <Insets top="15" right="15" bottom="15" left="15"/>
    </padding>

    <Label text="CineTrack — Gestion des salles" styleClass="titre"/>

    <GridPane hgap="10" vgap="10">
        <Label text="Nom" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
        <TextField fx:id="txtNom" GridPane.columnIndex="1" GridPane.rowIndex="0"/>
        <Label text="Capacité" GridPane.columnIndex="2" GridPane.rowIndex="0"/>
        <TextField fx:id="txtCapacite" GridPane.columnIndex="3" GridPane.rowIndex="0"/>

        <Label text="Équipements" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
        <HBox spacing="15" GridPane.columnIndex="1" GridPane.rowIndex="1" GridPane.columnSpan="3">
            <CheckBox fx:id="chkLunette4D" text="Lunette 4D"/>
            <CheckBox fx:id="chkDolby" text="Sound DOLBY ATMOS / IMAX"/>
            <CheckBox fx:id="chkLunette3D" text="Lunette 3D"/>
        </HBox>
    </GridPane>

    <HBox spacing="10">
        <Button text="Ajouter" onAction="#onAjouter"/>
        <Button text="Modifier" onAction="#onModifier"/>
        <Button text="Supprimer" onAction="#onSupprimer" styleClass="btn-supprimer"/>
        <Button text="Actualiser" onAction="#onActualiser"/>
    </HBox>

    <TableView fx:id="tableSalles" prefHeight="300" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="colId" text="ID" prefWidth="50"/>
            <TableColumn fx:id="colNom" text="Nom" prefWidth="200"/>
            <TableColumn fx:id="colCapacite" text="Capacité" prefWidth="100"/>
            <TableColumn fx:id="colEquipement" text="Équipements" prefWidth="350"/>
        </columns>
    </TableView>

    <Label fx:id="lblMessage"/>
</VBox>