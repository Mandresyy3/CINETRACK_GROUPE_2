<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="controller.AccueilController"
      spacing="25" prefWidth="760" prefHeight="420">

    <padding>
        <Insets top="30" right="30" bottom="30" left="30"/>
    </padding>

    <Label text="GESTIONNAIRE DE CINÉMA" styleClass="titre"/>

    <HBox spacing="30">
        <VBox styleClass="carte" spacing="10" HBox.hgrow="ALWAYS" maxWidth="Infinity" minHeight="190">
            <padding>
                <Insets top="20" right="20" bottom="20" left="20"/>
            </padding>
            <Label text="PROCHAINE SÉANCE" styleClass="carte-titre"/>
            <Label fx:id="lblProchaineFilm" styleClass="carte-film" wrapText="true"/>
            <Label fx:id="lblProchaineDetail"/>
        </VBox>

        <VBox styleClass="carte" spacing="10" HBox.hgrow="ALWAYS" maxWidth="Infinity" minHeight="190">
            <padding>
                <Insets top="20" right="20" bottom="20" left="20"/>
            </padding>
            <Label text="MIEUX NOTÉ" styleClass="carte-titre"/>
            <Label fx:id="lblMeilleurFilm" styleClass="carte-film" wrapText="true"/>
            <Label fx:id="lblMeilleurDetail"/>
            <Label fx:id="lblMeilleurDate"/>
        </VBox>
    </HBox>

    <HBox>
        <Button text="Actualiser" onAction="#onActualiser"/>
    </HBox>
</VBox>